<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0f0f13;
      --surface: #17171f;
      --surface2: #1e1e2a;
      --border: #2a2a3a;
      --text: #e8e8f0;
      --text-muted: #888899;
      --accent: #7c6ef0;
      --accent2: #4fc3a1;
      --warn: #e08060;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Noto Serif SC', 'Roboto', serif;
      min-height: 100vh;
    }

    /* ---- header ---- */
    .lib-header {
      text-align: center;
      padding: 56px 24px 40px;
      border-bottom: 1px solid var(--border);
      position: relative;
    }
    .lib-header::after {
      content: '';
      position: absolute;
      bottom: 0; left: 50%;
      transform: translateX(-50%);
      width: 80px; height: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      border-radius: 2px;
    }
    .lib-eyebrow {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--accent2);
      font-family: 'Roboto', sans-serif;
      font-weight: 400;
      margin-bottom: 16px;
    }
    .lib-title {
      font-size: clamp(28px, 5vw, 48px);
      font-weight: 700;
      letter-spacing: 0.02em;
      background: linear-gradient(135deg, #fff 0%, #b8b0f8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 12px;
    }
    .lib-subtitle {
      font-size: 15px;
      color: var(--text-muted);
      font-family: 'Roboto', sans-serif;
      font-weight: 300;
      letter-spacing: 0.5px;
    }
    .lib-count {
      display: inline-block;
      margin-top: 20px;
      font-size: 12px;
      color: var(--text-muted);
      font-family: 'Roboto', sans-serif;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 4px 14px;
    }

    /* ---- grid ---- */
    .lib-grid {
      max-width: 1100px;
      margin: 48px auto;
      padding: 0 24px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 24px;
    }

    /* ---- book card ---- */
    .book-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }
    .book-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 12px 40px rgba(124, 110, 240, 0.15);
    }

    .book-accent-bar {
      height: 4px;
      width: 100%;
    }

    .book-body {
      padding: 20px 22px 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .book-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }

    .book-author {
      font-size: 11px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--accent2);
      font-family: 'Roboto', sans-serif;
      font-weight: 500;
    }

    .book-badges {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }
    .badge {
      font-size: 10px;
      font-family: 'Roboto', sans-serif;
      padding: 2px 8px;
      border-radius: 10px;
      font-weight: 500;
    }
    .badge-lock {
      background: rgba(224, 128, 96, 0.15);
      color: var(--warn);
      border: 1px solid rgba(224, 128, 96, 0.3);
    }

    .book-title {
      font-size: 18px;
      font-weight: 600;
      line-height: 1.4;
      color: var(--text);
    }

    .book-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.7;
      font-family: 'Roboto', sans-serif;
      font-weight: 300;
      flex: 1;
    }

    .book-footer {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .book-date {
      font-size: 11px;
      color: var(--text-muted);
      font-family: 'Roboto', sans-serif;
    }
    .book-read {
      font-size: 11px;
      color: var(--accent);
      font-family: 'Roboto', sans-serif;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .book-read i { font-size: 10px; }

    /* ---- empty state ---- */
    .lib-empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 80px 24px;
      color: var(--text-muted);
    }
    .lib-empty i {
      font-size: 48px;
      display: block;
      margin-bottom: 16px;
      opacity: 0.3;
    }
    .lib-empty p {
      font-family: 'Roboto', sans-serif;
      font-size: 15px;
      line-height: 1.8;
    }

    /* ---- footer ---- */
    .lib-footer {
      text-align: center;
      padding: 32px 24px 48px;
      color: var(--text-muted);
      font-size: 12px;
      font-family: 'Roboto', sans-serif;
      border-top: 1px solid var(--border);
    }
    .lib-footer a {
      color: var(--accent);
      text-decoration: none;
    }

    @media (max-width: 480px) {
      .lib-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<header class="lib-header">
  <div class="lib-eyebrow">Bolan · 博览群书</div>
  <h1 class="lib-title">博览书库</h1>
  <p class="lib-subtitle">把书蒸馏成可对话的思想人格</p>
  <div class="lib-count"><%= books.length %> 本</div>
</header>

<div class="lib-grid">
  <% if (books.length === 0) { %>
  <div class="lib-empty">
    <i class="fas fa-book-open"></i>
    <p>书库还是空的。<br>在 QuickShare 里发布一个笔记，勾选「存入书库」就会出现在这里。</p>
  </div>
  <% } %>

  <%
    const PALETTES = [
      ['#7c6ef0', '#4fc3a1'],
      ['#e08060', '#f0b860'],
      ['#60a8e0', '#7c6ef0'],
      ['#4fc3a1', '#60d080'],
      ['#e060a0', '#7c6ef0'],
      ['#f0b860', '#e08060'],
    ];
    function bookPalette(id) {
      let n = 0;
      for (let i = 0; i < id.length; i++) n += id.charCodeAt(i);
      return PALETTES[n % PALETTES.length];
    }
    function formatDate(ts) {
      const d = new Date(ts);
      return d.getFullYear() + '.' + String(d.getMonth()+1).padStart(2,'0') + '.' + String(d.getDate()).padStart(2,'0');
    }
  %>

  <% books.forEach(book => {
    const [c1, c2] = bookPalette(book.id);
  %>
  <a class="book-card" href="/view/<%= book.id %>" target="_blank">
    <div class="book-accent-bar" style="background: linear-gradient(90deg, <%= c1 %>, <%= c2 %>);"></div>
    <div class="book-body">
      <div class="book-top">
        <% if (book.author) { %>
        <span class="book-author"><%= book.author %></span>
        <% } else { %>
        <span></span>
        <% } %>
        <div class="book-badges">
          <% if (book.is_protected) { %>
          <span class="badge badge-lock"><i class="fas fa-lock"></i> 加密</span>
          <% } %>
        </div>
      </div>
      <div class="book-title"><%= book.title || '无标题' %></div>
      <% if (book.description) { %>
      <p class="book-desc"><%= book.description %></p>
      <% } %>
      <div class="book-footer">
        <span class="book-date"><%= formatDate(book.created_at) %></span>
        <span class="book-read"><i class="fas fa-arrow-right"></i> 阅读</span>
      </div>
    </div>
  </a>
  <% }) %>
</div>

<footer class="lib-footer">
  Powered by <a href="/">QuickShare</a> &nbsp;·&nbsp; Bolan Skill
</footer>

</body>
</html>
